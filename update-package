#!/usr/bin/env bash
# macOS: Globally update or check LLM-related CLIs
# 包含：
#   - antigravity (agy)
#   - @openai/codex
#   - @anthropic-ai/claude-code
#   - @opencode/cli
# 功能：
#   - npm 包比较当前与最新版，版本一致则跳过
#   - Antigravity 使用官方安装器和 agy update，检查模式只显示当前版本
#   - 支持 --check 模式（仅检查不安装）
#   - 自动判断是否需 sudo
#   - 支持 PACKAGES / NPM_REGISTRY 环境变量覆盖

set -euo pipefail

# ------------------ 默认包列表 ------------------
DEFAULT_PACKAGES=(
  "antigravity"
  "@openai/codex"
  "@anthropic-ai/claude-code"
  "@opencode/cli"
)

# ------------------ 参数解析 ------------------
MODE="update"
if [[ "${1:-}" == "--check" ]]; then
  MODE="check"
fi

# ------------------ 环境变量覆盖 ------------------
if [[ -n "${PACKAGES:-}" ]]; then
  # shellcheck disable=SC2206
  PKGS=(${PACKAGES})
else
  PKGS=("${DEFAULT_PACKAGES[@]}")
fi

if [[ -n "${NPM_REGISTRY:-}" ]]; then
  npm config set registry "${NPM_REGISTRY}"
fi

# ------------------ 基础检查 ------------------
need() { command -v "$1" >/dev/null 2>&1 || { echo "❌ 缺少命令：$1"; exit 1; }; }
need node
need npm

USING_NVM="no"
if [[ -n "${NVM_DIR:-}" ]] || command -v nvm >/dev/null 2>&1 || [[ -s "$HOME/.nvm/nvm.sh" ]]; then
  USING_NVM="yes"
fi

PREFIX="$(npm config get prefix 2>/dev/null || echo "")"
SUDO_CMD=""
if [[ -n "$PREFIX" ]]; then
  if [[ ! -w "$PREFIX" ]] && [[ "$USING_NVM" != "yes" ]]; then
    SUDO_CMD="sudo"
  fi
fi

# ------------------ 函数定义 ------------------
npm_version() { npm view "$1" version; }

installed_version() {
  local name="$1"
  local json
  json="$(npm ls -g --depth=0 --json "$name" 2>/dev/null || true)"
  NAME="$name" node -e '
    const fs=require("fs");
    let s=""; process.stdin.on("data",d=>s+=d).on("end",()=>{
      try{
        const j=JSON.parse(s||"{}");
        const deps=j.dependencies||{};
        const n=process.env.NAME;
        if (deps[n] && deps[n].version) {
          console.log(deps[n].version);
        }
      }catch(e){}
    });
  ' <<<"$json"
}

cli_name_guess() {
  case "$1" in
    "@openai/codex") echo "codex" ;;
    "@anthropic-ai/claude-code") echo "claude-code" ;;
    "@opencode/cli") echo "opencode" ;;
    *) echo "" ;;
  esac
}

update_antigravity() {
  local PATH="$HOME/.local/bin:$PATH"
  echo "————————————————————————————————————————————————"
  echo "▶ Antigravity CLI (agy)"

  if [[ "$MODE" == "check" ]]; then
    if ! command -v agy >/dev/null 2>&1; then
      echo "  - 当前：未安装"
      return 0
    fi
  elif command -v agy >/dev/null 2>&1; then
    agy update || { echo "Antigravity 更新失败：agy update" >&2; return 1; }
  else
    need curl
    curl -fsSL https://antigravity.google/cli/install.sh | bash || {
      echo "Antigravity 安装失败：https://antigravity.google/cli/install.sh" >&2
      return 1
    }
  fi

  echo -n "  - 当前："
  AGY_CLI_DISABLE_AUTO_UPDATE=true agy --version || {
    echo "Antigravity 版本读取失败：agy --version" >&2
    return 1
  }
}

update_pkg() {
  local pkg="$1"
  local current latest tag=latest
  current="$(installed_version "$pkg" || true)"
  latest="$(npm_version "${pkg}@${tag}")" || {
    echo "版本查询失败：package=$pkg tag=$tag" >&2
    return 1
  }
  [[ -n "$latest" ]] || { echo "版本查询结果为空：package=$pkg tag=$tag" >&2; return 1; }

  echo "————————————————————————————————————————————————"
  echo "▶ 包：${pkg}（渠道：${tag}）"
  [[ -n "$current" ]] && echo "  - 当前：$current" || echo "  - 当前：未安装"
  [[ -n "$latest"  ]] && echo "  - 最新：$latest"

  # 新旧 npm 包都提供 opencode，安装新包前先释放旧包占用的命令。
  if [[ "$pkg" == "@opencode/cli" && -n "$PREFIX" && -d "$PREFIX/lib/node_modules/opencode-ai" ]]; then
    if [[ "$MODE" == "check" ]]; then
      echo "  - 旧包 opencode-ai：$(installed_version opencode-ai)（更新时迁移）"
    else
      echo "  - 正在卸载旧的 opencode-ai…"
      ${SUDO_CMD:-} npm uninstall -g opencode-ai || {
        echo "旧 OpenCode 卸载失败：package=opencode-ai prefix=$PREFIX" >&2
        return 1
      }
    fi
  fi

  # --- 仅检查模式 ---
  if [[ "$MODE" == "check" ]]; then
    if [[ -z "$latest" ]]; then
      echo "  - ⚠️ 无法获取最新版本"
    elif [[ -z "$current" ]]; then
      echo "  - 📦 尚未安装"
    elif [[ "$current" == "$latest" ]]; then
      echo "  - ✅ 已是最新版"
    else
      echo "  - ⬆️ 可更新：$current → $latest"
    fi
    return 0
  fi

  # --- 更新模式 ---
  if [[ -n "$current" && -n "$latest" && "$current" == "$latest" ]]; then
    echo "  - ✅ 已是最新版，跳过更新"
    return 0
  fi

  echo "  - 正在更新 → $tag..."
  if ${SUDO_CMD:-} npm install -g "${pkg}@${tag}"; then
    :
  else
    echo "更新失败：package=$pkg tag=$tag prefix=$PREFIX" >&2
    return 1
  fi

  local after
  after="$(installed_version "$pkg" || true)"
  echo "  - 更新后版本：${after:-未知}"

  local bin
  bin="$(cli_name_guess "$pkg")"
  if [[ -n "$bin" ]] && command -v "$bin" >/dev/null 2>&1; then
    echo -n "  - CLI 版本："
    "$bin" --version || { echo "CLI 校验失败：package=$pkg command=$bin" >&2; return 1; }
  fi
}

# ------------------ 主逻辑 ------------------
echo "Node: $(node -v)"
echo "npm : $(npm -v)"
echo "npm prefix: ${PREFIX:-unknown}  (nvm: $USING_NVM)"
[[ -n "${NPM_REGISTRY:-}" ]] && echo "registry: $NPM_REGISTRY"
echo "包列表：${PKGS[*]}"
echo "模式：$MODE"
echo "————————————————————————————————————————————————"

for p in "${PKGS[@]}"; do
  case "$p" in
    antigravity) update_antigravity || exit 1 ;;
    opencode-ai) update_pkg "@opencode/cli" || exit 1 ;;
    *) update_pkg "$p" || exit 1 ;;
  esac
done

echo "————————————————————————————————————————————————"
if [[ "$MODE" == "check" ]]; then
  echo "🔍 检查完成"
else
  echo "✅ 全部更新完成"
fi
